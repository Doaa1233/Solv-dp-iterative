#include<bits/stdc++.h>
#include <ext/pb_ds/assoc_container.hpp>
#include <ext/pb_ds/tree_policy.hpp>
using namespace std;
using namespace __gnu_pbds;
#define ll long long
#define int long long
#define ln "\n"
const int mod =1e9+7;
using ordered_set = tree<int, null_type, less_equal<int>, rb_tree_tag, tree_order_statistics_node_update>;

int32_t main() {
    ios::sync_with_stdio(false);cin.tie(nullptr);

    int t = 1;//cin>>t;
    while (t--) {
        int n;
        cin>>n;
        vector <int> a(n+1);
        vector <int> dp(n+1);
        // for(int i=1;i<=n;i++) {
        //     cin>>a[i];
        // }

        dp[0]=1;
        for(int i=1;i<=n;i++) {
            for(int j=1;j<=6;j++) {
                if (i-j>=0) {
                    dp[i]+=dp[i-j];
                }
                    if (dp[i]>=mod) {
                        dp[i]%=mod;

                }
            }
        }
            cout<<dp[n]<<ln;

    }
}
